# =============================================================================
# Real-Time Sequential Decision System for Pre-Hospital Emergency Survival
# Environment configuration template.
#
# Copy to `.env` at the repository root and adjust. NEVER commit a real `.env`.
#   cp .env.example .env
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list, or * for any origin (development only).
CORS_ORIGIN=http://localhost:5173

# --- Database (Module 11) ----------------------------------------------------
# SQLite is the zero-dependency development default. A relative `file:` URL is
# resolved by Prisma against the directory holding schema.prisma, i.e.
# modules/module_11_database_event_system/prisma/dev.db
# For PostgreSQL, switch the prisma provider (see module 11 README) and use e.g.:
#   postgresql://resus:CHANGE_ME@localhost:5432/resus?schema=public
DATABASE_URL="file:./dev.db"
# Set to true to run the development/demo seed (users, hospitals, ambulances,
# historical emergencies, events and outcomes). Never enable in production.
SEED_DEMO_DATA=false
# Deployment region for hospitals / ambulance posts: sabarimala (default) or demo-bengaluru.
SEED_REGION=sabarimala

# --- Authentication / Authorization -------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRES_IN=1h
# Bootstrap operator account created by the seed/migrate step (development only).
SEED_OPERATOR_EMAIL=operator@resus.local
SEED_OPERATOR_PASSWORD=ChangeMe!2024

# --- Telephony (Module 1) ----------------------------------------------------
# `loopback` (default) is the development adapter: it never places a real call
# and always reports isLive=false. `asterisk` is the only adapter in this build
# that carries a live call leg and real media.
TRANSPORT_PROVIDER=loopback
# Ignored by `loopback`. For `asterisk` this is the AMI endpoint, as host:port:
#   TRANSPORT_PROVIDER=asterisk
#   TRANSPORT_SIGNALLING_URL=127.0.0.1:5038
TRANSPORT_SIGNALLING_URL=
CALL_DEFAULT_LANGUAGE=en
CALL_MAX_DURATION_MINUTES=30
CALL_PROVIDER_TIMEOUT_MS=10000

# --- Asterisk PBX (Module 1; only when TRANSPORT_PROVIDER=asterisk) -----------
# Manager account from /etc/asterisk/manager.conf. Without a secret the server
# refuses to boot rather than starting a line that cannot answer.
ASTERISK_AMI_USERNAME=resus
ASTERISK_AMI_SECRET=
ASTERISK_AMI_CONNECT_TIMEOUT_MS=5000
# Defaults to CALL_PROVIDER_TIMEOUT_MS when unset.
ASTERISK_AMI_ACTION_TIMEOUT_MS=10000
# In-process AudioSocket server. Asterisk dials this, so it is the TCP client.
ASTERISK_AUDIOSOCKET_BIND_HOST=0.0.0.0
ASTERISK_AUDIOSOCKET_BIND_PORT=9092
# Address written into the dialplan. Must be a concrete address the PBX can
# reach (e.g. the WSL/VM IP) — never 0.0.0.0.
ASTERISK_AUDIOSOCKET_ADVERTISE_HOST=127.0.0.1
# Dialplan location an originated call enters; it must run AudioSocket().
ASTERISK_DIALPLAN_CONTEXT=resus
ASTERISK_DIALPLAN_EXTEN=s
ASTERISK_DIALPLAN_PRIORITY=1
ASTERISK_DEFAULT_ENDPOINT=PJSIP/1001
# Inbound: the channel variable the dialplan tags an inbound leg with, and the
# service-area coordinates used because a trunk carries no location. Required
# when TRANSPORT_PROVIDER=asterisk.
ASTERISK_INBOUND_UUID_VARIABLE=RESUS_INBOUND_UUID
ASTERISK_INBOUND_EXTEN=1000
ASTERISK_INBOUND_LAT=
ASTERISK_INBOUND_LNG=
# Media bridge: greeting spoken on answer, and voice-activity-detection tuning.
ASTERISK_GREETING=Emergency line. Tell me what happened.
ASTERISK_GREETING_TONE=CALM
ASTERISK_SPEECH_RMS_THRESHOLD=700
ASTERISK_HANGOVER_MS=800
ASTERISK_MIN_UTTERANCE_MS=400
ASTERISK_MAX_UTTERANCE_MS=30000
ASTERISK_RESOLVE_TIMEOUT_MS=5000

# --- Speech (Module 2) -------------------------------------------------------
# `loopback` (default) does no recognition or synthesis and is labelled as such.
# `whisper` recognises speech offline via whisper.cpp; `espeak` synthesises it
# offline via espeak-ng. Both are local binaries: no API key, no cloud call.
SPEECH_PROVIDER=loopback
SPEECH_SYNTHESIS_PROVIDER=loopback
SPEECH_MIN_CONFIDENCE=0.45
SPEECH_EMIT_PARTIALS=true
SPEECH_MAX_AUDIO_BYTES=512000
SPEECH_TIMEOUT_MS=15000
SPEECH_MAX_SYNTHESIS_CHARS=2000
# Read only when SPEECH_PROVIDER=whisper; the model path is then mandatory.
WHISPER_CPP_BINARY=whisper-cli
WHISPER_CPP_MODEL=
WHISPER_CPP_THREADS=4
WHISPER_CPP_LANGUAGE=auto
# Read only when SPEECH_SYNTHESIS_PROVIDER=espeak.
ESPEAK_NG_BINARY=espeak-ng
ESPEAK_NG_VOICE=en-gb
# eSpeak NG uses approximate words per minute; default is 175. 145 is about 83%.
ESPEAK_NG_SPEED_WPM=145
# Reserved for engines that need an external resampler; the built-in converter
# is used otherwise, so ffmpeg is not required by the shipped providers.
FFMPEG_BINARY=ffmpeg

# --- LLM (Module 5) ----------------------------------------------------------
# Free, local, offline inference. No paid provider calls anywhere in this repo.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Per-request timeout (ms) for LLM calls.
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
# When Ollama cannot be reached the engine degrades to a clearly-labelled
# deterministic heuristic extractor instead of inventing LLM output.
LLM_ALLOW_HEURISTIC_FALLBACK=true
# Number of protocol turns before a session is flagged for escalation review.
PROTOCOL_MAX_CLARIFICATIONS=3
# Protocol catalogue directory (defaults to the module 5 `protocols/` folder).
PROTOCOL_DIR=

# --- Protocol Engine (Module 5) ----------------------------------------------
# Medical content is data, not code. Review protocol versions before use.
PROTOCOL_DEFAULT_VERSION=1.0.0
# Fail closed if a protocol file fails schema validation.
PROTOCOL_STRICT_VALIDATION=true

# --- Ambulance Management (Module 6) -----------------------------------------
# Simulation data is flagged everywhere (is_simulation, `simulated` API field).
# Simulation and production records are never merged silently.
SIMULATION_MODE=false
SIMULATION_TICK_MS=2000
SIMULATION_AMBULANCE_COUNT=8
# Average km/h used for response-time estimation when routing is unavailable.
AMBULANCE_AVERAGE_SPEED_KMH=45
AMBULANCE_DISPATCH_SPEED_KMH=60
# Maximum radius considered by the assignment engine (km).
ASSIGNMENT_MAX_RADIUS_KM=25
# Automatic assignment is opt-in. Leave `false` to require a dispatcher to use
# POST /api/ambulances/assign. Setting `true` allows event-driven assignment only;
# a dispatcher must still use POST /api/ambulances/:id/dispatch to dispatch it.
# Missing or any non-`true` value keeps automatic assignment disabled.
MODULE6_AUTO_DISPATCH_ENABLED=false
MODULE6_AUTO_DISPATCH_SIMULATION=false

# --- Hospital Intelligence (Module 7) ----------------------------------------
# Hospital selection scores the seeded hospitals against their declared
# capabilities and last-reported resource availability (Module 11
# `HospitalResource` rows), never inventing beds or travel times. It runs
# automatically on EMERGENCY_CLASSIFIED, writing only the emergency's
# `selectedHospitalId` and the HOSPITAL_SELECTED / HOSPITAL_REJECTED events; it
# never changes status, protocols or ambulance assignment. Automatic selection
# is opt-in; set to `true` to enable. Simulation emergencies are excluded unless
# the second flag is `true`.
MODULE7_AUTO_SELECT_ENABLED=false
MODULE7_AUTO_SELECT_SIMULATION=false
# Hospitals farther than this are not candidates (km).
MODULE7_MAX_DISTANCE_KM=30

# --- Emergency NLP (Module 3) ------------------------------------------------
# The existing Python service (modules/module3_emergency_nlp) is invoked over
# HTTP by POST /api/emergencies/:id/classify. It is disabled by default: it must
# be running, and its own LLM provider is configured on that side. The route
# records the result as NLP_EXTRACTION_COMPLETED / NLP_EXTRACTION_REJECTED and
# never changes emergency status, protocols or ambulance assignment.
MODULE3_NLP_ENABLED=false
MODULE3_NLP_URL=http://127.0.0.1:8003
MODULE3_NLP_TIMEOUT_MS=8000

# --- Conversation Support (Module 4) -----------------------------------------
# Module 4 is a thin layer over the Module 5 protocol engine; it never decides
# what is said. Two optional capabilities, both off by default:
#
# Localisation renders the protocol's reviewed wording into the call's language
# by looking its stable instructionId up in a reviewed translation table. It is
# NOT machine translation: if the table has no entry, the protocol wording is
# spoken unchanged and the fallback is logged. MODULE4_TRANSLATIONS_FILE is a JSON
# file of the form { "<instructionId>": { "<language>": "<reviewed text>" } }.
MODULE4_LOCALISATION_ENABLED=false
MODULE4_TRANSLATIONS_FILE=
# Caller silence: after a prompt, if the caller says nothing for this many
# milliseconds the bridge repeats the protocol's current instruction. At most two
# re-prompts are permitted (MODULE4_SILENCE_RETRY_LIMIT, 0-2); after the budget is
# spent the conversation is escalated to an operator (CONVERSATION_TIMED_OUT /
# CONVERSATION_ESCALATED events) and no further automatic prompting happens for
# that call. The call is NOT ended and the emergency is NOT closed. 0 disables
# silence handling entirely.
MODULE4_SILENCE_TIMEOUT_MS=0
MODULE4_SILENCE_RETRY_LIMIT=2

# --- Dashboard / Analytics (Module 12) ---------------------------------------
# The following legacy analytics/model variables are retained for compatibility
# with older deployments; current Module 12 configuration does not read them.
# Analytics windows
ANALYTICS_DEFAULT_WINDOW_DAYS=30
# Legacy learning threshold; the current Module 12 implementation does not read
# this variable or train/activate models.
LEARNING_MIN_SAMPLES_FOR_MODEL=25
# Legacy Bayesian prior values; current Module 12 does not read these variables.
LEARNING_PRIOR_ALPHA=1
LEARNING_PRIOR_BETA=1
# Learning-sample persistence is disabled unless explicitly opted in.
# This does not enable training or model activation.
MODULE12_LEARNING_ENABLED=false
MODULE12_LEARNING_MIN_SAMPLES=10
# Simulation rows are excluded from analytics by default.
MODULE12_INCLUDE_SIM=false

# --- Map / Frontend ----------------------------------------------------------
# Default map centre (used when the dashboard has no focus emergency).
MAP_DEFAULT_LAT=9.3897
MAP_DEFAULT_LNG=77.0594
MAP_DEFAULT_ZOOM=12
# Free, no-API-key tile source used by the dashboard map.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- Route Optimization (Module 8) ------------------------------------------
# Determines which routing provider to use. 'mock' is deterministic and safe.
# Google is an explicit, server-only opt-in and may incur Google Maps Platform billing.
# Keep the key restricted to Routes API and never expose it to browser/mobile clients.
# Set to 'osrm' only if an OSRM instance is reachable; keep 'mock' for local simulation.
MODULE8_PROVIDER=mock
# Average speed (km/h) assumed when the provider does not specify travel time.
MODULE8_AVERAGE_SPEED_KMH=60
# OSRM (ignored unless MODULE8_PROVIDER=osrm).
MODULE8_OSRM_BASE_URL=http://router.project-osrm.org
MODULE8_OSRM_TIMEOUT_MS=8000
# Google Routes API (used only when MODULE8_PROVIDER=google).
MODULE8_GOOGLE_API_KEY=
MODULE8_GOOGLE_TIMEOUT_MS=8000
# Automatic route generation on AMBULANCE_DISPATCHED and HOSPITAL_SELECTED.
# It is opt-in; set to `true` to enable.
MODULE8_AUTO_ROUTE_ENABLED=false
# Whether automatic generation should plan routes for simulation emergencies.
MODULE8_AUTO_ROUTE_SIMULATION=false

# --- Corridor Coordination (Module 9) ---------------------------------------
# Corridors are ALWAYS simulated: there is no traffic-signal controller, no live
# road-user feed and no messaging provider in this repository. Nothing here can
# clear a real corridor, and no notification is ever delivered.
# Automatic corridor coordination on HOSPITAL_SELECTED / ROUTE_GENERATED.
# It is opt-in; set to `true` to enable.
MODULE9_CORRIDOR_ENABLED=false
# Corridor half-width in metres (geofence used to place simulated road users).
MODULE9_CORRIDOR_RADIUS_M=150
# Whether corridors are coordinated for simulation emergencies (harness-driven).
MODULE9_CORRIDOR_SIMULATION=false
# Number of simulated road users the deterministic provider places per corridor.
MODULE9_SIMULATED_ROAD_USERS=3

# --- Autonomous orchestration (Module 10) + Web Call (Module 1 in the browser) --
# `npm run dev:full` / `npm run start:full` switch all automation on for you.
# With these on, a call placed at http://localhost:4000/call is classified,
# an ambulance assigned + dispatched, a hospital selected, routes and a corridor
# planned, and (for ambulances with no driver account) the drive is simulated
# through scene arrival, patient onboard, hospital arrival and completion.
MODULE10_AUTONOMOUS_ENABLED=false
# Accept offers for ambulances that have no driver account (simulated crews).
MODULE10_AUTO_ACCEPT_UNSTAFFED=true
# Dispatch automatically once an offer is accepted (by a driver or the system).
MODULE10_AUTO_DISPATCH=true
# Animate unstaffed ambulances along their routes (GPS updates every tick).
MODULE10_SIMULATE_MOVEMENT=true
# Real travel minutes are divided by this when animating (20 => 8 min in 24 s).
MODULE10_TIME_COMPRESSION=20
MODULE10_TICK_MS=1500
MODULE10_SCENE_DWELL_MS=8000
MODULE10_HOSPITAL_DWELL_MS=6000
# Idle simulated crews re-report their station position so they stay eligible.
MODULE10_STATION_HEARTBEAT_MS=120000
# Location used by a web call when the browser does not share GPS.
WEBCALL_DEFAULT_LAT=9.3897
WEBCALL_DEFAULT_LNG=77.0594
MODULE10_QUEUE_SWEEP_MS=10000
# Prefix of allotted case numbers (SBM-2026-000123).
CASE_NUMBER_PREFIX=SBM

# --- Dedicated helpline number (Exotel) ---------------------------------------
# Exotel owns the phone number; its "Voicebot" applet streams each call to
#   wss://<your-public-server>/telephony/exotel/stream?token=<EXOTEL_STREAM_TOKEN>
# Requires SPEECH_PROVIDER=whisper and SPEECH_SYNTHESIS_PROVIDER=espeak (both
# have Windows builds). Generate the token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXOTEL_ENABLED=false
EXOTEL_STREAM_TOKEN=
EXOTEL_SAMPLE_RATE=8000
EXOTEL_SPEECH_RMS_THRESHOLD=700
EXOTEL_HANGOVER_MS=900

# --- Security -------------------------------------------------------------------
# Behind nginx / a cloud load balancer set TRUST_PROXY=true (real client IPs in
# rate limits and the access audit). Always serve over HTTPS in production.
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_CALL_START_PER_MIN=20
# Developer-only tools (password-less /api/auth/dev-token, protocol chat). Never
# enable on a shared or police deployment; ignored when NODE_ENV=production.
RESUS_DEV_TOOLS=false
