# ── Runtime ──
NODE_ENV=development
PORT=8010
LOG_LEVEL=debug

# ── Internal Auth ──
INTERNAL_API_TOKEN=change-me-in-production

# ── PostgreSQL (Module 11) ──
DATABASE_URL=postgresql://emergency:secret@localhost:5432/emergency_db

# ── Redis (Event Bus) ──
REDIS_URL=redis://localhost:6379

# ── Downstream Module URLs ──
MODULE_3_URL=http://module-nlp:8003
MODULE_6_URL=http://module-ambulance:8006
MODULE_7_URL=http://module-hospital:8007
MODULE_8_URL=http://module-route:8008
MODULE_9_URL=http://module-corridor:8009

# ── Dashboard WebSocket CORS ──
DASHBOARD_ORIGIN=http://localhost:3000
